# EsiFit AI — server-only (never NEXT_PUBLIC_*)
# Provider: anthropic | gemini | openrouter | custom | mock
AI_PROVIDER=mock
AI_MODEL=
AI_TIMEOUT_MS=25000

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=https://api.openai.com/v1

# Optional: usage JSONL directory (defaults to /tmp/esifit-ai)
AI_USAGE_DIR=

# Optional observability hint (full Sentry SDK can be added later)
SENTRY_DSN=
