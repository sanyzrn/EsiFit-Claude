# API
PORT=3001
DATABASE_URL=postgresql://esifit:esifit@localhost:5432/esifit
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Public API URL used in payment gateway callbacks (defaults to localhost:PORT)
# API_PUBLIC_URL=https://api.example.com

# Email (password reset) — omit for dev console logging
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@esifit.com

# SMS OTP — console logs codes in dev; use kavenegar in production
SMS_PROVIDER=console
# SMS_PROVIDER=kavenegar
# KAVENEGAR_API_KEY=
# KAVENEGAR_TEMPLATE=esifit-otp

# Payments: auto = zarinpal → idpay → stripe
PAYMENTS_PROVIDER=auto

# Zarinpal (primary Iranian gateway) — amounts are Tomans×10 = Rials
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_SANDBOX=true

# IDPay (fallback Iranian gateway)
# IDPAY_API_KEY=
# IDPAY_SANDBOX=true

# Plan prices in Tomans (defaults match product pricing)
# PRICE_ECONOMY_TOMAN=599000
# PRICE_VIP_TOMAN=999000
# PRICE_ELITE_TOMAN=1999000

# Stripe (optional non-Iranian provider)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ECONOMY=
# STRIPE_PRICE_VIP=
# STRIPE_PRICE_ELITE=
