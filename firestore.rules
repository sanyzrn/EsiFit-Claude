rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'subscriptionTier', 'createdAt']) &&
             data.keys().size() <= 16 &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 128 &&
             data.role in ['USER', 'COACH', 'ADMIN'] &&
             data.subscriptionTier in ['FREE', 'ECONOMY', 'VIP', 'ELITE'] &&
             data.createdAt is string &&
             (!('age' in data) || data.age is number) &&
             (!('gender' in data) || (data.gender is string && data.gender.size() <= 32)) &&
             (!('heightCm' in data) || data.heightCm is number) &&
             (!('weightKg' in data) || data.weightKg is number) &&
             (!('goal' in data) || data.goal in ['MUSCLE_GAIN', 'FAT_LOSS', 'GENERAL_FITNESS', 'STRENGTH']) &&
             (!('activityLevel' in data) || data.activityLevel in ['SEDENTARY', 'LIGHT', 'MODERATE', 'ACTIVE', 'VERY_ACTIVE']) &&
             (!('injuries' in data) || (data.injuries is string && data.injuries.size() <= 1024)) &&
             (!('savedExercises' in data) || (
               data.savedExercises is list && data.savedExercises.size() <= 100
             ));
    }

    function isValidUserCreate(data) {
      return isValidUser(data) &&
             data.role == 'USER' &&
             data.subscriptionTier == 'FREE';
    }

    function isValidProfileUpdate() {
      return isValidUser(incoming()) &&
             incoming().role == existing().role &&
             incoming().subscriptionTier == existing().subscriptionTier &&
             incoming().email == existing().email &&
             incoming().createdAt == existing().createdAt &&
             !incoming().diff(existing()).affectedKeys().hasAny(['role', 'subscriptionTier', 'email', 'createdAt', 'stripeCustomerId']) &&
             incoming().diff(existing()).affectedKeys().hasOnly(
               ['name', 'age', 'gender', 'heightCm', 'weightKg', 'goal', 'activityLevel', 'injuries', 'savedExercises']
             );
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && isOwner(userId) &&
                       isValidUserCreate(incoming());
      allow update: if isSignedIn() && isValidId(userId) && isOwner(userId) &&
                       isValidProfileUpdate();
    }

    function isValidBodyLog(data) {
      return data.keys().hasAll(['userId', 'date']) &&
             data.keys().size() <= 12 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.date is string && data.date.size() <= 32 &&
             (!('weightKg' in data) || data.weightKg is number) &&
             (!('waistCm' in data) || data.waistCm is number) &&
             (!('neckCm' in data) || data.neckCm is number) &&
             (!('hipCm' in data) || data.hipCm is number) &&
             (!('chestCm' in data) || data.chestCm is number) &&
             (!('armCm' in data) || data.armCm is number) &&
             (!('bodyFatPct' in data) || data.bodyFatPct is number) &&
             (!('bodyFatPercent' in data) || data.bodyFatPercent is number) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 512));
    }

    match /bodyLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(logId) && isValidBodyLog(incoming());
      allow update: if isSignedIn() && isValidId(logId) && resource.data.userId == request.auth.uid &&
                       isValidBodyLog(incoming()) &&
                       incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(logId) && resource.data.userId == request.auth.uid;
    }

    function isValidExerciseLog(data) {
      return data.keys().hasAll(['userId', 'exerciseId', 'exerciseName', 'date', 'sets', 'reps', 'weightKg']) &&
             data.keys().size() <= 10 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.exerciseId is string && data.exerciseId.size() <= 128 &&
             data.exerciseName is string && data.exerciseName.size() <= 256 &&
             data.date is string && data.date.size() <= 32 &&
             data.sets is number && data.reps is number && data.weightKg is number;
    }

    match /exerciseLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(logId) && isValidExerciseLog(incoming());
      allow update: if isSignedIn() && isValidId(logId) && resource.data.userId == request.auth.uid &&
                       isValidExerciseLog(incoming()) &&
                       incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(logId) && resource.data.userId == request.auth.uid;
    }

    function isValidCalculatorResult(data) {
      return data.keys().hasAll(['userId', 'type', 'inputJson', 'resultJson', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.type is string && data.type.size() <= 64 &&
             data.inputJson is map && data.resultJson is map &&
             data.createdAt is string && data.createdAt.size() <= 32;
    }

    match /calculatorResults/{resultId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(resultId) && isValidCalculatorResult(incoming());
      allow update: if isSignedIn() && isValidId(resultId) && resource.data.userId == request.auth.uid &&
                       isValidCalculatorResult(incoming()) &&
                       incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(resultId) && resource.data.userId == request.auth.uid;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'senderId', 'senderName', 'content', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.id is string && data.senderId is string && data.senderName is string &&
             data.content is string && data.content.size() <= 4096 &&
             data.createdAt is string;
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['userId', 'subject', 'status', 'messages']) &&
             data.keys().size() <= 6 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.subject is string && data.subject.size() <= 256 &&
             data.status in ['open', 'closed'] &&
             data.messages is list && data.messages.size() <= 100 &&
             data.messages.size() >= 1;
    }

    match /tickets/{ticketId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(ticketId) && isValidTicket(incoming());
      allow update: if isSignedIn() && isValidId(ticketId) && resource.data.userId == request.auth.uid &&
                       isValidTicket(incoming()) &&
                       incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(ticketId) && resource.data.userId == request.auth.uid;
    }
  }
}
