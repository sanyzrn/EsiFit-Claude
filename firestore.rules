rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'subscriptionTier', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 128 &&
             data.role in ['USER', 'COACH', 'ADMIN'] &&
             data.subscriptionTier in ['FREE', 'ECONOMY', 'VIP', 'ELITE'] &&
             data.createdAt is string;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && isOwner(userId) &&
                       isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && isOwner(userId) &&
                       isValidUser(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'subscriptionTier']);
    }

    function isValidBodyLog(data) {
      return data.keys().hasAll(['userId', 'date', 'weightKg']) &&
             data.keys().size() <= 4 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.date is string && data.date.size() <= 32 &&
             data.weightKg is number;
    }

    match /bodyLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(logId) && isValidBodyLog(incoming());
      allow update: if isSignedIn() && isValidId(logId) && resource.data.userId == request.auth.uid &&
                       isValidBodyLog(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['weightKg', 'bodyFatPercent']);
      allow delete: if isSignedIn() && isValidId(logId) && resource.data.userId == request.auth.uid;
    }
  }
}
